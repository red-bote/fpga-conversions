# Download zips fetched by download_darfpga.sh
/downloads/

# Unzipped Dar source trees (regenerated by unzip_darfpga.sh); also covers the
# copyrighted generated PROM VHDL and the shipped tool binaries inside them.
# Exception: our own make_<game>_proms.sh scripts are tracked (each parent dir
# must be re-included for the negation to take effect).
**/vhdl_*/*
!**/vhdl_*/tools/
**/vhdl_*/tools/*
!**/vhdl_*/tools/*_unzip/
**/vhdl_*/tools/*_unzip/*
!**/vhdl_*/tools/*_unzip/make_*_proms.sh

# Copyrighted MAME-derived content is never committed — extra safety net
*.zip

# Vivado build junk (keep .xpr/.xdc/.vhd sources visible)
**/.runs/
**/.cache/
**/.gen/
**/.hw/
**/.sim/
**/.ip_user_files/
*.jou
*.log
*.str
*.wdb
