diff --git a/vhdl_phoenix_DE10_lite/rtl_dar/phoenix.vhd b/vhdl_phoenix_DE10_lite/rtl_dar/phoenix.vhd
--- a/vhdl_phoenix_DE10_lite/rtl_dar/phoenix.vhd
+++ b/vhdl_phoenix_DE10_lite/rtl_dar/phoenix.vhd
@@ -26,7 +26,17 @@
 -- video_hs     : out std_logic;
 -- video_vs     : out std_logic;
  audio_select : in std_logic_vector(2 downto 0);
- audio        : out std_logic_vector(11 downto 0)
+ audio        : out std_logic_vector(11 downto 0);
+-- External control inputs (Basys3 JA joystick / dedicated buttons), active-high.
+-- OR-merged with the PS/2-derived controls below; PS/2 keyboard keeps working
+-- unmodified when these are left low.
+ ext_coin     : in std_logic := '0';
+ ext_start1   : in std_logic := '0';
+ ext_start2   : in std_logic := '0';
+ ext_fire     : in std_logic := '0';
+ ext_right    : in std_logic := '0';
+ ext_left     : in std_logic := '0';
+ ext_up       : in std_logic := '0'
 );
 end phoenix;
 
@@ -427,12 +437,12 @@
 );
 
 -- joystick to inputs
-coin            <= not JoyPCFRLDU(7); -- F3 : Add coin
-player_start(1) <= not JoyPCFRLDU(6); -- F2 : Start 2 Players
-player_start(0) <= not JoyPCFRLDU(5); -- F1 : Start 1 Player
-buttons(0)      <= not JoyPCFRLDU(4); -- SPACE : Fire
-buttons(1)      <= not JoyPCFRLDU(3); -- RIGHT arrow : Right
-buttons(2)      <= not JoyPCFRLDU(2); -- LEFT arrow  : Left
-buttons(3)      <= not JoyPCFRLDU(0); -- UP arrow : Protection 
+coin            <= not JoyPCFRLDU(7) or ext_coin;   -- F3 : Add coin
+player_start(1) <= not JoyPCFRLDU(6) or ext_start2; -- F2 : Start 2 Players
+player_start(0) <= not JoyPCFRLDU(5) or ext_start1; -- F1 : Start 1 Player
+buttons(0)      <= not JoyPCFRLDU(4) or ext_fire;   -- SPACE : Fire
+buttons(1)      <= not JoyPCFRLDU(3) or ext_right;  -- RIGHT arrow : Right
+buttons(2)      <= not JoyPCFRLDU(2) or ext_left;   -- LEFT arrow  : Left
+buttons(3)      <= not JoyPCFRLDU(0) or ext_up;     -- UP arrow : Protection 
 
 end struct;
