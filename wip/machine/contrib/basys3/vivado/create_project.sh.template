#!/bin/bash
# Generic create_project.sh template.
#
# Create the initial Vivado Basys3 project for the <game> port in the
# extracted Dar source tree, copied from the wip sample Vivado project
# (wip/machine/contrib/basys3/basys3-project-template/), and rename it to the
# port project name.
#
# The source of the ported .xpr and .xdc is the sample Vivado project:
#   wip/machine/contrib/basys3/basys3-project-template.xpr
#   wip/machine/contrib/basys3/basys3-project-template.srcs/constrs_1/imports/digilent-xdc-master/Basys-3-Master.xdc
#
# 1. Create the project dirs in <src_dir>/basys3/<game>_basys3*.
# 2. Copy basys3-project-template.xpr -> <game>_basys3.xpr, re-pointing its
#    project root (basys3-project-template) and top source to <game>_basys3.
# 3. Copy the template top VHDL source as <game>_basys3.vhd (later overwritten
#    by make_de10_lite_to_basys3_patch.sh with the authored top level).
# 4. Copy Basys-3-Master.xdc into constrs_1/imports/digilent-xdc-master/,
#    uncommenting/renaming only the port lines the port uses.
# 5. [if scandoubler] Copy the scandoubler into sources_1/imports/mist/.
#
# clk_wiz_0 IP generation (make_clk_wiz_0.sh) is separate.
#
# Substitute: <game> (snake_case), <src_dir> (extracted archive dir),
# <TOP_ENTITY> (Basys3 top entity, e.g. galaga_basys3),
# <WITH_SCANDOUBLER> (whether the port imports an external scandoubler:
#   set to a real scandoubler import step, or drop it for cores that double
#   scanlines internally).
# Copy to <Machine>-by-Dar/contrib/basys3/vivado/create_project.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
SRC_DIR="$ROOT/<src_dir>"
WIP_TEMPLATE="$ROOT/wip/machine/contrib/basys3/basys3-project-template"

PROJ_DIR="$SRC_DIR/basys3"
PROJ="$PROJ_DIR/<game>_basys3"
CONSTRS_IMPORT="$PROJ.srcs/constrs_1/imports/digilent-xdc-master"
SOURCES_NEW="$PROJ.srcs/sources_1/new"
# [if scandoubler] SOURCES_IMPORT="$PROJ.srcs/sources_1/imports/mist"

if [ ! -d "$SRC_DIR" ]; then
    echo "error: source tree not found: $SRC_DIR" >&2
    echo "Run contrib/tools/setup_<game>.sh first." >&2
    exit 1
fi

step() { printf '\n==> %s\n' "$1"; }

step "1/4 Creating project directories"
mkdir -p "$PROJ_DIR" "$CONSTRS_IMPORT" "$SOURCES_NEW" \
    # [if scandoubler] "$SOURCES_IMPORT"

step "2/4 Copying basys3-project-template.xpr as <game>_basys3.xpr"
cp -f "$WIP_TEMPLATE.xpr" "$PROJ_DIR/<game>_basys3.xpr"
# Re-point the .xpr project root name and top source filename from the
# template to the port name. #REVIEW: adjust sed patterns to your .xpr.
sed -i \
    -e 's|basys3-project-template|<game>_basys3|g' \
    -e 's|basys3-top\.vhd|<game>_basys3.vhd|g' \
    "$PROJ_DIR/<game>_basys3.xpr"

step "3/4 Copying template top VHDL source as <game>_basys3.vhd"
cp -f "$WIP_TEMPLATE.srcs/sources_1/new/basys3-top.vhd" "$SOURCES_NEW/<game>_basys3.vhd"

step "4/4 Copying Basys-3-Master.xdc"
cp -f "$WIP_TEMPLATE.srcs/constrs_1/imports/digilent-xdc-master/Basys-3-Master.xdc" \
      "$CONSTRS_IMPORT/Basys-3-Master.xdc"
# Uncomment/rename only the XDC port lines the port uses (see root PORTING_SPEC §3).

# [if scandoubler]
# step "5/5 Copying scandoubler into sources_1/imports/mist/"
# cp -f "$ROOT/contrib/code/scandoubler.v" "$SOURCES_IMPORT/scandoubler.v"

echo
echo "Project files in place:"
ls -l "$PROJ_DIR/<game>_basys3.xpr"
ls -l "$CONSTRS_IMPORT/Basys-3-Master.xdc"
ls -l "$SOURCES_NEW/<game>_basys3.vhd"
