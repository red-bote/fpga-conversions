#!/bin/bash
# Generic make_clk_wiz_0.sh template.
#
# Generate the clk_wiz_0 MMCM IP (100 MHz -> <clk_freq> core) for the
# Basys3 port and place its Verilog wrappers where <game>_basys3.xpr expects them.
#
# The main project's .xpr references two imported files (<game>_basys3.xpr):
#   sources_1/imports/clk_wiz_0/clk_wiz_0.v
#   sources_1/imports/clk_wiz_0/clk_wiz_0_clk_wiz.v
# The IP is generated here in a throwaway Vivado project named <mmcm_name> and
# only those two .v files are copied into the repo. Per project rules this script
# runs from /tmp so vivado.log / vivado.jou stay outside the repository.
#
# Multi-output cores (e.g. Pooyan video + sound) add further
# CONFIG.CLKOUTn_USED / CONFIG.CLKOUTn_REQUESTED_OUT_FREQ lines.
#
# Substitute: <game> (snake_case), <src_dir> (extracted archive dir),
# <clk_freq> (clk_out1 frequency in MHz), <mmcm_name> (throwaway project name,
# e.g. mmcm_36m).
# Copy to <Machine>-by-Dar/contrib/basys3/vivado/make_clk_wiz_0.sh.

set -euo pipefail

VIVADO=/tools/Xilinx/Vivado/2020.2/bin/vivado
PART=xc7a35tcpg236-1

# Absolute path to this repo's basys3 port tree.
XPR_DIR="$(cd "$(dirname "$0")/../../../<src_dir>/basys3" && pwd)"
CLK_WIZ_IMPORT_DIR="$XPR_DIR/<game>_basys3.srcs/sources_1/imports/clk_wiz_0"

# Throwaway project location (logs stay outside the repo).
WORK=/tmp/<mmcm_name>
TCL=$WORK/gen_clk_wiz_0.tcl

rm -rf "$WORK"
mkdir -p "$WORK"

cat > "$TCL" <<EOF
create_project <mmcm_name> "$WORK" -part $PART -force

create_ip -name clk_wiz -vendor xilinx.com -library ip -version 6.0 \
    -module_name clk_wiz_0 -dir "$WORK"

set_property -dict [list \
    CONFIG.PRIMITIVE {MMCM} \
    CONFIG.PRIM_SOURCE {Single_ended_clock_capable_pin} \
    CONFIG.CLKIN1_JITTER_PS {50.0} \
    CONFIG.CLKOUT1_USED {true} \
    CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {<clk_freq>} \
    CONFIG.USE_PHASE_ALIGNMENT {true} \
] [get_ips clk_wiz_0]

generate_target all [get_ips clk_wiz_0]
EOF

"$VIVADO" -mode batch -nolog -nojournal -source "$TCL"

GEN_DIR="$WORK/clk_wiz_0"
mkdir -p "$CLK_WIZ_IMPORT_DIR"
cp "$GEN_DIR/clk_wiz_0.v"            "$CLK_WIZ_IMPORT_DIR/"
cp "$GEN_DIR/clk_wiz_0_clk_wiz.v"    "$CLK_WIZ_IMPORT_DIR/"

rm -rf "$WORK"

echo "Generated clk_wiz_0 IP files:"
ls -l "$CLK_WIZ_IMPORT_DIR"
