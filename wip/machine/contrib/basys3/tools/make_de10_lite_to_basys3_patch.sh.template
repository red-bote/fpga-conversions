#!/bin/bash
# Generic make_de10_lite_to_basys3_patch.sh template.
#
# Generate the patch that adapts the upstream DE10-lite top level
# (rtl_dar/<DE10_TOP>) into the Basys3 top level (<TOP_ENTITY>.vhd).
#
# The target <TOP_ENTITY>.vhd is authored here (it is a full rewrite of the
# top-level wrapper). The script:
#   1. Writes the target VHDL to a scratch dir.
#   2. Diffs it against the pristine upstream source to produce the git-style
#      patch at contrib/basys3/code/<game>_de10_lite_to_basys3.patch.
#   3. Places the target where <game>_basys3.xpr expects it
#      (basys3/<game>_basys3.srcs/sources_1/new/<game>_basys3.vhd).
#
# The VHDL body below is machine-specific: author it per port (see the
# <Machine>-by-Dar/PORTING_SPEC.md and the external-IO convention in the root
# PORTING_SPEC.md §3). If the port imports a scandoubler, the VHDL must include
# the scandoubler wiring (component + instance + clock derivation).
#
# Requires the pristine tree (run `make setup` first).
# Per project rules this script runs from /tmp so scratch stays outside the repo.
#
# Substitute: <game> (snake_case), <src_dir> (extracted archive dir),
# <DE10_TOP> (upstream DE10-lite top filename, e.g. galaga_de10_lite.vhd),
# <TOP_ENTITY> (Basys3 top entity, e.g. galaga_basys3).
# Copy to <Machine>-by-Dar/contrib/basys3/tools/make_de10_lite_to_basys3_patch.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
SRC="$ROOT/<src_dir>/rtl_dar/<DE10_TOP>"
PROJ_DIR="$ROOT/<src_dir>/basys3"
TARGET_SRC="$PROJ_DIR/<game>_basys3.srcs/sources_1/new"
PATCH="$ROOT/contrib/basys3/code/<game>_de10_lite_to_basys3.patch"

WORK=/tmp/<game>_de10_to_basys3
TARGET="$WORK/<game>_basys3.vhd"

if [ ! -f "$SRC" ]; then
    echo "error: pristine source not found: $SRC" >&2
    echo "Run 'make setup' first to populate <src_dir>/." >&2
    exit 1
fi

rm -rf "$WORK"
mkdir -p "$WORK"

cat > "$TARGET" <<'EOF'
<<AUTHOR TOP-LEVEL VHDL HERE>>
EOF

# Emit git-style patch (matches the *_de10_lite_to_basys3.patch convention).
{
  printf 'diff --git a/<src_dir>/rtl_dar/<DE10_TOP> b/<src_dir>/rtl_dar/<DE10_TOP>\n'
  diff -u --label "a/<src_dir>/rtl_dar/<DE10_TOP>" \
            --label "b/<src_dir>/rtl_dar/<DE10_TOP>" \
            "$SRC" "$TARGET" || [ $? -eq 1 ]   # diff returns 1 when files differ (expected)
} > "$PATCH"

mkdir -p "$TARGET_SRC"
cp -f "$TARGET" "$TARGET_SRC/<game>_basys3.vhd"

rm -rf "$WORK"

echo "Generated patch:  $PATCH"
echo "Placed target:    $TARGET_SRC/<game>_basys3.vhd"
echo "Verify with:      patch -p1 --dry-run < contrib/basys3/code/<game>_de10_lite_to_basys3.patch"
